<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="MagicOnion.Abstractions" Version="7.11.0"/>
        <!-- (MagicOnion 7.11.0 asks for MessagePack 3.1.7 or later: 3.1.9 fixes GHSA-qhrr-8q5h-9q3h, nested arrays past buffer limits) -->
        <PackageReference Include="MessagePack" Version="3.1.12"/>
    </ItemGroup>
</Project>
