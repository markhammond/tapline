@* What the page shows above the grid, as the ChalkQL blotter's status bar: the house's state, the memory the LiveGrid
   provider keeps for this page's grid — its session — against the session's budget (the process's, for a source that
   can't say), and the page's lag (the feed is among the vital statistics, under the grid). It renders on its own, every
   second, and only when a figure has moved by 5 % or more: on a slow link every render is sent, and a figure that flickers
   in its last digit says nothing. *@
@implements IDisposable
@using LiveGrid.Sample.Domain
@inject House House

<span class="chip @(House.Paused ? "behind" : "live")"><b>@(House.Paused ? "Outage" : "Live")</b></span>
@if (_parts > 0)
{
    <span class="chip" title="@_breakdown">
        <span class="label">session</span><b>@Size(_held)</b><span class="label">of</span>@Size(_bound)
    </span>
}
else
{
    <span class="chip" title="The process's working set, and its managed heap: read in the process, approximate">
        <span class="label">host</span><b>@Figures.Two(_workingSet) MB</b><span class="label">heap</span>@Figures.Two(_heap) MB
    </span>
}
<span class="chip" title="How far this page is behind the house: from a change — an order's new version, a fill — to this browser drawing it, the worst in the last second it drew one">
    <span class="label">lag</span><b>@(_lag is { } lag ? Figures.Two(lag) + " s" : "–")</b>
</span>

@code {
    /// <summary>The source whose memory it shows: the tab's.</summary>
    [Parameter]
    public ISourceMemory? Source { get; set; }

    /// <summary>The view the tab's grid reads — its session's, what the source keeps for it (null till it starts).</summary>
    [Parameter]
    public Func<GridView?>? View { get; set; }

    /// <summary>The page's lag, as the tab's grid has it.</summary>
    [Parameter]
    public Func<TimeSpan?>? Lag { get; set; }

    private double _workingSet, _heap, _held, _bound;
    private int _parts;
    private string _breakdown = "";
    private double? _lag;
    private bool _paused;
    private Timer? _timer;

    protected override void OnInitialized()
    {
        Read();
        _timer = new Timer(_ => InvokeAsync(() =>
        {
            var (workingSet, heap, lag, paused, held, bound) = (_workingSet, _heap, _lag, _paused, _held, _bound);
            Read();
            if (paused != _paused || Figures.Moved(workingSet, _workingSet) || Figures.Moved(heap, _heap) ||
                Figures.Moved(lag ?? 0, _lag ?? 0) || Figures.Moved(held, _held) || Figures.Moved(bound, _bound))
                StateHasChanged();
        }), null, 1000, 1000);
    }

    private void Read()
    {
        _workingSet = Environment.WorkingSet / 1048576.0;
        _heap = GC.GetTotalMemory(false) / 1048576.0;
        IReadOnlyList<(string Part, GridMemory Memory)> parts = Source?.MemoryOf(View?.Invoke()) ?? [], shared = Source?.Memory ?? [];
        (_parts, _held, _bound) = (parts.Count, parts.Sum(p => (double)p.Memory.Held), parts.Sum(p => (double)p.Memory.Bound));
        _breakdown = "What the LiveGrid provider keeps for this page's grid — its session — against the session's budget, worked out from what it holds: " +
                     string.Join("; ", parts.Select(p => $"{p.Part} {Size(p.Memory.Held)} of {Size(p.Memory.Bound)}")) +
                     ". The provider's own, every session's: " +
                     string.Join("; ", shared.Select(p => $"{p.Part} {Size(p.Memory.Held)} of {Size(p.Memory.Bound)}")) +
                     $". The process: {Figures.Two(_workingSet)} MB, its heap {Figures.Two(_heap)} MB (the house, the web server and the runtime too).";
        _lag = Lag?.Invoke()?.TotalSeconds;
        _paused = House.Paused;
    }

    /// <summary>Bytes as the bar shows them: megabytes, gigabytes from a thousand of those.</summary>
    private static string Size(double bytes)
    {
        var mb = bytes / 1048576.0;
        return mb < 1000 ? $"{Figures.Two(mb)} MB" : $"{Figures.Two(mb / 1024)} GB";
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }

}
