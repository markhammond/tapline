@* One column's filter, as the ChalkQL blotter edits it, docked above the grid while it's open: by the column's kind —
   ids typed or pasted, matched exactly; text picked from the column's most frequent values over the period of interest,
   or typed, matched exactly or by what it starts with; names from a short list ticked; numbers at least, at most; times
   from, to (UTC). *@
@using System.Globalization
@implements IDisposable
@inject IColumnValues Values

<div class="editor" role="dialog" aria-label="Filter @Column.Title">
    <div class="editor-head">
        <b>Filter @Column.Title</b>
        @if (_kind == ColumnKind.Text)
        {
            <select @bind="_match" aria-label="How values match">
                <option value="@TextMatch.AnyOf">is any of</option>
                <option value="@TextMatch.StartsWith">starts with</option>
            </select>
        }
        <span class="spacer"></span>
        <button type="button" class="primary" @onclick="ApplyAsync">Apply</button>
        <button type="button" @onclick="ClearAsync">Clear</button>
        <button type="button" @onclick="() => OnClose.InvokeAsync()" aria-label="Close">✕</button>
    </div>

    @switch (_kind)
    {
        case ColumnKind.Text or ColumnKind.Id:
            <div class="pills" @onclick="FocusAsync">
                @foreach (var value in _values)
                {
                    var v = value;
                    <span class="pill">@v <button type="button" aria-label="Remove @v" @onclick="() => _values.Remove(v)"
                                                  @onclick:stopPropagation>×</button></span>
                }
                <input @ref="_input" type="text" value="@_typed" aria-label="@(_kind == ColumnKind.Id ? $"{Column.Title} ids" : $"{Column.Title} values")"
                       placeholder="@(_values.Count > 0 ? "" : _kind == ColumnKind.Id ? "type or paste an id, Enter to add" : "type a value, Enter to add")"
                       @oninput="TypedAsync" @onkeydown="KeyAsync"/>
                @if (_values.Count > 0 || _typed.Length > 0)
                {
                    <button type="button" class="clear-input" aria-label="Clear" @onclick="ClearInputAsync"
                            @onclick:stopPropagation>×</button>
                }
            </div>
            @if (_kind == ColumnKind.Text)
            {
                <div class="chooser">
                    <div class="chooser-head">
                        @(_typed.Length > 0 ? $"Values starting {_typed}" : "Most frequent values"), @Column.Title of rows @TimeLabel @Period
                        @if (_loading)
                        {
                            <span class="muted"> · reading…</span>
                        }
                    </div>
                    @foreach (var (value, rows) in _choices)
                    {
                        var v = value;
                        <button type="button" class="choice @(_values.Contains(v) ? "picked" : "")" @onclick="() => Add(v)">
                            @v <span class="muted">@rows.ToString("N0", CultureInfo.InvariantCulture)</span>
                        </button>
                    }
                    @if (!_loading && _choices.Count == 0)
                    {
                        <span class="muted">No values in this period.</span>
                    }
                </div>
            }
            break;

        case ColumnKind.Choice:
            <div class="statuses">
                @foreach (var name in Column.Choices)
                {
                    var n = name;
                    <label><input type="checkbox" checked="@_values.Contains(n)" @onchange="e => Tick(n, e.Value is true)"/> @n</label>
                }
            </div>
            break;

        case ColumnKind.Integer or ColumnKind.Number:
            <div class="range">
                <label>at least <input type="number" step="any" @bind="_min"/></label>
                <label>at most <input type="number" step="any" @bind="_max"/></label>
            </div>
            break;

        case ColumnKind.Time:
            <div class="range">
                @* Empty, the browser starts a time where the page is: these are UTC, so an empty one starts at the time in UTC now,
                   set as it takes the focus (on the page, before its picker opens), as if typed. *@
                <label>from <input type="datetime-local" step="1" @bind="_from" onfocus="@NowInUtc"/></label>
                <label>to <input type="datetime-local" step="1" @bind="_to" onfocus="@NowInUtc"/></label>
                <span class="muted">UTC</span>
            </div>
            break;
    }
    @if (_refusal is not null)
    {
        <div class="refused">@_refusal</div>
    }
</div>

@code {
    private const int Offered = 50; // values the chooser offers, at most

    /// <summary>The column filtered, as the catalog has it: its name, heading, kind and choices.</summary>
    [Parameter, EditorRequired]
    public Column Column { get; set; } = default!;

    /// <summary>The column's filter now, if any.</summary>
    [Parameter]
    public ColumnFilter? Current { get; set; }

    /// <summary>The period whose orders the chooser offers values from (UTC), and the time column's heading.</summary>
    [Parameter, EditorRequired]
    public (DateTime From, DateTime To) Within { get; set; }

    [Parameter] public string TimeLabel { get; set; } = "time";

    /// <summary>The column's filter as edited (empty: the column's filter removed).</summary>
    [Parameter]
    public EventCallback<ColumnFilter> OnApply { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private readonly List<string> _values = [];
    private List<(string Value, long Rows)> _choices = [];
    private (Column? Column, ColumnFilter? Current) _editing;
    private ElementReference _input;
    private ColumnKind _kind;
    private bool _loading;
    private TextMatch _match;
    private double? _min, _max;
    private DateTime? _from, _to;

    /// <summary>A time input's focus handler, the page's: empty, it's set to the time in UTC now, to the second, as if typed.</summary>
    private const string NowInUtc =
        "if (!this.value) { this.value = new Date().toISOString().slice(0, 19); this.dispatchEvent(new Event('change', {bubbles: true})); }";
    private CancellationTokenSource? _reading;
    private string? _refusal;
    private string _typed = "";

    private string Period => string.Create(CultureInfo.InvariantCulture, $"{Within.From:MM-dd HH:mm} to {Within.To:MM-dd HH:mm} UTC");

    protected override async Task OnParametersSetAsync()
    {
        if (_editing == (Column, Current)) return; // (the page renders with every change; it starts over for another column, or a filter applied)
        _editing = (Column, Current);
        _kind = Column.Kind;
        _values.Clear();
        _values.AddRange(Current?.Values ?? []);
        (_match, _min, _max, _from, _to) = (Current?.Match ?? TextMatch.AnyOf, Current?.Min, Current?.Max, Current?.From, Current?.To);
        (_typed, _refusal) = ("", null);
        if (_kind == ColumnKind.Text) await ReadChoicesAsync();
    }

    private async Task TypedAsync(ChangeEventArgs change)
    {
        _typed = (string?)change.Value ?? "";
        if (_kind == ColumnKind.Text) await ReadChoicesAsync();
    }

    private async Task KeyAsync(KeyboardEventArgs key)
    {
        if (key.Key is "Enter" or "," or "Tab" && _typed.Trim().Length > 0)
        {
            foreach (var value in _typed.Split([',', ' ', '\n'], StringSplitOptions.RemoveEmptyEntries)) Add(value); // (ids pasted several at once)
            _typed = "";
            if (_kind == ColumnKind.Text) await ReadChoicesAsync();
        }
        else if (key.Key == "Backspace" && _typed.Length == 0 && _values.Count > 0)
        {
            _values.RemoveAt(_values.Count - 1);
        }
    }

    /// <summary>
    ///     The column's values among the period's orders, the most frequent first, starting with what's typed: read as the
    ///     editor opens and as the reader types, a moment after the last key, the latest read winning.
    /// </summary>
    private async Task ReadChoicesAsync()
    {
        _reading?.Cancel();
        var reading = _reading = new CancellationTokenSource();
        _loading = true;
        try
        {
            await Task.Delay(200, reading.Token);
            var (column, start, within) = (Column.Name, _typed.Length > 0 ? _typed : null, Within);
            var found = await Task.Run(() => Values.ValuesOf(column, within.From, within.To, start, Offered, reading.Token), reading.Token);
            if (reading.IsCancellationRequested) return;
            _choices = found;
        }
        catch (OperationCanceledException) when (reading.IsCancellationRequested)
        {
            return;
        }

        _loading = false;
    }

    private void Add(string value)
    {
        value = value.Trim();
        if (value.Length > 0 && !_values.Contains(value)) _values.Add(value);
    }

    private void Tick(string value, bool ticked)
    {
        if (ticked) Add(value);
        else _values.Remove(value);
    }

    private async Task ClearInputAsync()
    {
        _values.Clear();
        _typed = "";
        if (_kind == ColumnKind.Text) await ReadChoicesAsync();
    }

    private async Task FocusAsync()
    {
        await _input.FocusAsync();
    }

    private async Task ApplyAsync()
    {
        if (_typed.Trim().Length > 0)
            foreach (var value in _typed.Split([',', ' ', '\n'], StringSplitOptions.RemoveEmptyEntries)) Add(value);
        if (_kind == ColumnKind.Id && _values.FirstOrDefault(v => !Guid.TryParse(v, out _)) is { } wrong)
        {
            _refusal = $"Not an id: {wrong}";
            return;
        }

        await OnApply.InvokeAsync(new ColumnFilter
        {
            Column = Column.Name, Kind = Column.Kind, Label = Column.Title, Values = [.. _values], Match = _kind == ColumnKind.Text ? _match : TextMatch.AnyOf,
            Min = _min, Max = _max, From = _from, To = _to
        });
    }

    private Task ClearAsync()
    {
        return OnApply.InvokeAsync(new ColumnFilter { Column = Column.Name, Kind = Column.Kind, Label = Column.Title });
    }

    public void Dispose()
    {
        _reading?.Cancel();
    }

}
