@* A bell: alerts. Muted, fainter: the page may not make sound. *@
<svg class="bell @(Muted ? "silent" : "")" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
    <path d="M4 11.5V7.2a4 4 0 0 1 8 0v4.3l1.2 1.3H2.8z"/>
    <path d="M6.6 14a1.5 1.5 0 0 0 2.8 0"/>
    @if (Muted)
    {
        <path d="M2 2l12 12"/>
    }
</svg>

@code {
    [Parameter] public bool Muted { get; set; }
}
