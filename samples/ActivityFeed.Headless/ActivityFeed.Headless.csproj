<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/Tapline.MagicOnion/Tapline.MagicOnion.csproj"/>
        <ProjectReference Include="../ActivityFeed.Contracts/ActivityFeed.Contracts.csproj"/>
        <!-- The backend it spawns when no router is named: the practice service, the app and the dispatcher, built with
             it, and each run from its own build output (named below). The service's people and rows are read here too. -->
        <ProjectReference Include="../ActivityFeed.Service/ActivityFeed.Service.csproj"/>
        <ProjectReference Include="../ActivityFeed.Sample/ActivityFeed.Sample.csproj"/>
        <ProjectReference Include="../ActivityFeed.Dispatcher/ActivityFeed.Dispatcher.csproj"/>
        <AssemblyMetadata Include="ActivityFeed.Service"
                          Value="$(MSBuildThisFileDirectory)../ActivityFeed.Service/bin/$(Configuration)/$(TargetFramework)/ActivityFeed.Service.dll"/>
        <AssemblyMetadata Include="ActivityFeed.Sample"
                          Value="$(MSBuildThisFileDirectory)../ActivityFeed.Sample/bin/$(Configuration)/$(TargetFramework)/ActivityFeed.Sample.dll"/>
        <AssemblyMetadata Include="ActivityFeed.Dispatcher"
                          Value="$(MSBuildThisFileDirectory)../ActivityFeed.Dispatcher/bin/$(Configuration)/$(TargetFramework)/ActivityFeed.Dispatcher.dll"/>
    </ItemGroup>
</Project>
