<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <PackageId>Tapline</PackageId>
        <PackageLicenseExpression>Elastic-2.0</PackageLicenseExpression>
        <PackageTags>$(PackageTags);aspnetcore;blazor;blazor-server;signalr;grpc;magiconion;authentication;passkeys;webauthn</PackageTags>
        <Description>Tapline's router hosted in ASP.NET Core: real-time, last-mile fan-out of shared state and ordered messages, over a Blazor Server circuit or MagicOnion (gRPC); data providers in process or in their own; sign-in by modules (passkeys, passthrough, tickets, your own); the ops port, the router's viewer and the browser client (tapline.js).</Description>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/Tapline.AspNetCore/Tapline.AspNetCore.csproj" PrivateAssets="all"/>
        <ProjectReference Include="../../src/Tapline.BlazorRealtime/Tapline.BlazorRealtime.csproj" PrivateAssets="all"/>
        <ProjectReference Include="../../src/Tapline.Authentication/Tapline.Authentication.csproj" PrivateAssets="all"/>
        <ProjectReference Include="../../src/Tapline.MagicOnion.Server/Tapline.MagicOnion.Server.csproj" PrivateAssets="all"/>
        <ProjectReference Include="../../src/Tapline.MagicOnion.Providers/Tapline.MagicOnion.Providers.csproj" PrivateAssets="all"/>
        <ProjectReference Include="../Tapline.Client/Tapline.Client.Package.csproj"/>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
        <PackageReference Include="MagicOnion.Server" Version="$(MagicOnionVersion)"/>
        <!-- The browser's scripts, served at _content/Tapline/ (as the projects serve them: their StaticWebAssetBasePath). -->
        <Content Include="../../src/Tapline.AspNetCore/wwwroot/tapline.js" Link="wwwroot/tapline.js"/>
        <Content Include="../../src/Tapline.BlazorRealtime/wwwroot/blazor-realtime.js" Link="wwwroot/blazor-realtime.js"/>
    </ItemGroup>
</Project>
