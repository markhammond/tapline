<Project>
    <PropertyGroup>
        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);TaplineBundleBuildOutput</TargetsForTfmSpecificBuildOutput>
        <TargetsForTfmSpecificDebugSymbolsInPackage>$(TargetsForTfmSpecificDebugSymbolsInPackage);TaplineBundleSymbols</TargetsForTfmSpecificDebugSymbolsInPackage>
    </PropertyGroup>

    <!-- The licence, as a file: nuget.org takes a licence expression only of licences the OSI or the FSF approve, so a
         package under the Elastic License 2.0 names a file instead (PackageLicenseFile LICENSE.txt), as ChalkQL's do,
         written from LICENSE as it's packed. One with parts under Apache-2.0 too (TaplineApacheParts:
         Tapline.Authentication.Opaque's) has a line first saying which is which, and Apache-2.0's text after the Elastic
         License's. A package under Apache-2.0 alone declares that expression, and packs its text as LICENSE. -->
    <PropertyGroup>
        <_TaplineElastic>false</_TaplineElastic>
        <_TaplineElastic Condition="'$(PackageLicenseFile)' == 'LICENSE.txt'">true</_TaplineElastic>
        <_TaplineElasticText>$(MSBuildThisFileDirectory)../LICENSE</_TaplineElasticText>
        <_TaplineApacheText>$(MSBuildThisFileDirectory)../src/Tapline.Authentication.Opaque/LICENSE</_TaplineApacheText>
        <_TaplineLicenceFile>$(BaseIntermediateOutputPath)LICENSE.txt</_TaplineLicenceFile>
    </PropertyGroup>
    <ItemGroup>
        <None Include="$(_TaplineLicenceFile)" Pack="true" PackagePath="/" Visible="false" Condition="$(_TaplineElastic)"/>
        <None Include="$(_TaplineApacheText)" Pack="true" PackagePath="/" Visible="false" Condition="'$(PackageLicenseExpression)' == 'Apache-2.0'"/>
    </ItemGroup>
    <Target Name="TaplineLicenceFile" BeforeTargets="GenerateNuspec" Condition="$(_TaplineElastic)">
        <ItemGroup>
            <_TaplineLicenceText Include="$(_TaplineElasticText)"/>
            <_TaplineLicenceText Include="$(_TaplineApacheText)" Condition="'$(TaplineApacheParts)' == 'true'"/>
        </ItemGroup>
        <PropertyGroup>
            <_TaplineLicencePreamble Condition="'$(TaplineApacheParts)' == 'true'">$(PackageId) is licensed under the Elastic License 2.0 (first below), except password sign-in by OPAQUE (Tapline.Authentication.Opaque), which is licensed under the Apache License 2.0 (second below).</_TaplineLicencePreamble>
        </PropertyGroup>
        <TaplineWriteLicence Texts="@(_TaplineLicenceText)" Preamble="$(_TaplineLicencePreamble)" Output="$(_TaplineLicenceFile)"/>
    </Target>

    <!-- The licence file's text: each text whole, a rule between them, after the preamble if there is one; written only
         when it changes. -->
    <UsingTask TaskName="TaplineWriteLicence" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <Texts ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true"/>
            <Preamble ParameterType="System.String"/>
            <Output ParameterType="System.String" Required="true"/>
        </ParameterGroup>
        <Task>
            <Code Type="Fragment" Language="cs"><![CDATA[
                var rule = "\n" + new string('-', 80) + "\n\n";
                var parts = new System.Collections.Generic.List<string>();
                if (!string.IsNullOrWhiteSpace(Preamble)) parts.Add(Preamble.Trim() + "\n");
                foreach (var text in Texts) parts.Add(System.IO.File.ReadAllText(text.ItemSpec).TrimEnd() + "\n");
                var body = string.Join(rule, parts);
                if (!System.IO.File.Exists(Output) || System.IO.File.ReadAllText(Output) != body) System.IO.File.WriteAllText(Output, body);
            ]]></Code>
        </Task>
    </UsingTask>

    <!-- A package's browser files are its own static web assets (Content linked into wwwroot), at the paths the projects
         they come from serve them; the projects' own copies, referenced, aren't taken as well (the same paths twice). -->
    <Target Name="TaplineOwnStaticWebAssetsOnly" AfterTargets="ResolveReferencedProjectsStaticWebAssetsConfiguration">
        <ItemGroup>
            <StaticWebAssetProjectConfiguration Remove="@(StaticWebAssetProjectConfiguration)"/>
        </ItemGroup>
    </Target>

    <!-- The assemblies bundled: the projects referenced with PrivateAssets="all", each asked for its output (no build:
         packing with NoBuild too), its XML docs and symbols beside it. -->
    <Target Name="TaplineBundled">
        <ItemGroup>
            <_TaplineBundledProject Include="@(ProjectReference->'%(FullPath)')" Condition="'%(ProjectReference.PrivateAssets)' == 'all'"/>
        </ItemGroup>
        <Error Condition="'@(_TaplineBundledProject)' == ''" Text="$(MSBuildProjectName) bundles no assembly."/>
        <MSBuild Projects="@(_TaplineBundledProject)" Targets="GetTargetPath" Properties="Configuration=$(Configuration)"
                 RemoveProperties="TargetFramework;RuntimeIdentifier;NoBuild">
            <Output TaskParameter="TargetOutputs" ItemName="_TaplineBundledDll"/>
        </MSBuild>
        <ItemGroup>
            <_TaplineBundledCandidate Include="@(_TaplineBundledDll->'%(FullPath)');@(_TaplineBundledDll->'%(RootDir)%(Directory)%(Filename).xml');@(_TaplineBundledDll->'%(RootDir)%(Directory)%(Filename).pdb')"/>
            <TaplineBundledFile Include="@(_TaplineBundledCandidate)" Condition="Exists('%(FullPath)')"/>
        </ItemGroup>
        <Error Condition="'@(TaplineBundledFile->WithMetadataValue('Extension', '.dll')->Count())' != '@(_TaplineBundledProject->Count())'"
               Text="$(MSBuildProjectName): @(_TaplineBundledProject->Count()) projects bundled, but not each one's DLL built (@(_TaplineBundledDll))."/>
    </Target>

    <!-- lib/: the bundled DLLs and their XML docs, never this project's own (empty) assembly. -->
    <Target Name="TaplineBundleBuildOutput" DependsOnTargets="TaplineBundled">
        <ItemGroup>
            <BuiltProjectOutputGroupOutput Remove="@(BuiltProjectOutputGroupOutput)"/>
            <DocumentationProjectOutputGroupOutput Remove="@(DocumentationProjectOutputGroupOutput)"/>
            <BuildOutputInPackage Include="@(TaplineBundledFile)" Condition="'%(Extension)' == '.dll' or '%(Extension)' == '.xml'"
                                  TargetFramework="$(TargetFramework)"/>
        </ItemGroup>
        <Error Condition="'@(BuildOutputInPackage->WithMetadataValue('Extension', '.dll'))' == ''" Text="$(MSBuildProjectName): no DLL to pack."/>
    </Target>

    <!-- The .snupkg: the bundled assemblies' symbols. -->
    <Target Name="TaplineBundleSymbols" DependsOnTargets="TaplineBundled">
        <ItemGroup>
            <DebugSymbolsProjectOutputGroupOutput Remove="@(DebugSymbolsProjectOutputGroupOutput)"/>
            <TfmSpecificDebugSymbolsFile Include="@(TaplineBundledFile)" Condition="'%(Extension)' == '.pdb'"
                                         TargetFramework="$(TargetFramework)"/>
        </ItemGroup>
    </Target>
</Project>
