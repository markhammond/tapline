<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- (its wwwroot is served where its package, Tapline, serves it: packages/Tapline) -->
        <StaticWebAssetBasePath>_content/Tapline</StaticWebAssetBasePath>
        <RootNamespace>Tapline.Alerts</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <!-- Tapline's core alone: alerts know nothing of grids (virtual-grid.md §15.2, decision (o)). -->
        <ProjectReference Include="../Tapline/Tapline.csproj"/>
        <InternalsVisibleTo Include="Tapline.Tests"/>
    </ItemGroup>
</Project>
