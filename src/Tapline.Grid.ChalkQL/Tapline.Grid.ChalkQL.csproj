<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <RootNamespace>Tapline.Grid.ChalkQL</RootNamespace>
        <!-- The views' filters kept incrementally (ViewMaintenance.Incremental) is ChalkQL's experimental CHALK003: acknowledged here. -->
        <NoWarn>$(NoWarn);CHALK003</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <!-- The provider's contract alone: no session, no component, no ASP.NET Core. -->
        <ProjectReference Include="../Tapline.Grid.Provider/Tapline.Grid.Provider.csproj"/>
        <PackageReference Include="ChalkQL" Version="$(ChalkQLVersion)"/>
        <PackageReference Include="ChalkQL.Sources" Version="$(ChalkQLVersion)"/>
        <InternalsVisibleTo Include="Tapline.Grid.ChalkQL.Tests"/>
    </ItemGroup>
</Project>
