<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <RootNamespace>Tapline.Grid</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <!-- A reader's session: its window over the source, kept and published through Tapline (the order, the status), its
             requests and holds — nothing of ASP.NET Core; Blazor's component is Tapline.Grid.Blazor's. -->
        <ProjectReference Include="../Tapline/Tapline.csproj"/>
        <ProjectReference Include="../Tapline.Grid.Provider/Tapline.Grid.Provider.csproj"/>
        <InternalsVisibleTo Include="Tapline.Grid.Blazor"/>
        <InternalsVisibleTo Include="Tapline.Tests"/>
    </ItemGroup>
</Project>
