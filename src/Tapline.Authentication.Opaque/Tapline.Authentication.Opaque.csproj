<Project Sdk="Microsoft.NET.Sdk.Razor">
    <!-- Copyright 2026 Mark Hammond. Licensed under the Apache License, Version 2.0 (see LICENSE). -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- (its wwwroot is served where its package, Tapline.Wasm, serves it: packages/Tapline.Wasm) -->
        <StaticWebAssetBasePath>_content/Tapline.Wasm</StaticWebAssetBasePath>
        <!-- (wasm/: opaque.wasm's Rust source and its build output, not the project's) -->
        <DefaultItemExcludes>$(DefaultItemExcludes);wasm/**</DefaultItemExcludes>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Tapline.Authentication/Tapline.Authentication.csproj"/>
        <ProjectReference Include="../Tapline.Client.Opaque/Tapline.Client.Opaque.csproj"/>
        <InternalsVisibleTo Include="Tapline.Tests"/>
    </ItemGroup>
</Project>
