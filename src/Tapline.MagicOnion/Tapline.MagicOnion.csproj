<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageLicenseExpression>EPL-2.0</PackageLicenseExpression>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <PackageId>Tapline.MagicOnion</PackageId>
        <PackageTags>$(PackageTags);grpc;magiconion;client</PackageTags>
        <Description>Tapline over MagicOnion (gRPC, HTTP/2): the stream's contract — one duplex call per connection, frames down, what the client says up — and the client's side, carrying Tapline.Client.</Description>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="MagicOnion.Client" Version="7.11.0"/>
        <!-- (MagicOnion 7.11.0 asks for MessagePack 3.1.7 or later: 3.1.9 fixes GHSA-qhrr-8q5h-9q3h, nested arrays past buffer limits) -->
        <PackageReference Include="MessagePack" Version="3.1.12"/>
        <ProjectReference Include="../Tapline.Client/Tapline.Client.csproj"/>
    </ItemGroup>
</Project>
