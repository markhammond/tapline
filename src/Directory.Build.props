<Project>
    <!-- What every Tapline assembly shares. None is a package of its own: the projects in packages/ bundle them, four
         packages in all, versioned together. -->
    <PropertyGroup>
        <Version>0.1.1</Version>
        <Authors>Mark Hammond</Authors>
        <Copyright>Copyright © 2026 Mark Hammond</Copyright>
        <RepositoryUrl>https://github.com/markhammond/tapline</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <IsPackable>false</IsPackable>
        <!-- (each package takes an assembly's name, Tapline.Client say: its project needs another id in the restore graph) -->
        <PackageId>$(MSBuildProjectName).Assembly</PackageId>

        <!-- IntelliSense for consumers. Missing or partial comments aren't errors; a broken cref still is. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>

        <!-- Debuggable from the package: symbols beside it (.snupkg), sources linked to the commit (Source Link). -->
        <DebugType>portable</DebugType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <!-- The packages' dependencies, the same version wherever they're taken. -->
    <PropertyGroup>
        <HealthChecksVersion>10.0.5</HealthChecksVersion>
        <MagicOnionVersion>7.11.0</MagicOnionVersion>
        <!-- (MagicOnion 7.11.0 asks for MessagePack 3.1.7 or later: 3.1.9 fixes GHSA-qhrr-8q5h-9q3h, nested arrays past buffer limits) -->
        <MessagePackVersion>3.1.12</MessagePackVersion>
        <WasmtimeVersion>48.0.2</WasmtimeVersion>
    </PropertyGroup>
</Project>
